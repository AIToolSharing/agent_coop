[Unit]
Description=coop hub
After=network-online.target
Wants=network-online.target

[Service]
User=coop
Group=coop
# /var/lib/coop: made by systemd, owned by coop, writable under ProtectSystem=strict.
StateDirectory=coop
ExecStart=/usr/local/bin/coop serve --listen 127.0.0.1:8090 --data /var/lib/coop
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
