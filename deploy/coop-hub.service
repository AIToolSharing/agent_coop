[Unit]
Description=coop hub API (behind Caddy)
After=nats.service
Requires=nats.service

[Service]
User=coop
Group=coop
EnvironmentFile=/etc/coop/hub.env
ExecStart=/usr/bin/node /opt/coop/packages/hub/dist/main.js serve
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
